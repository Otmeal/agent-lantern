{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Lantern",
  "version": "0.1.0",
  "identifier": "dev.agentlantern.overlay",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Lantern",
        "width": 320,
        "height": 180,
        "minWidth": 260,
        "minHeight": 96,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "../../daemon/dist-bundle/agent-lantern-daemon.cjs": "daemon/agent-lantern-daemon.cjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Windows overlay for remote AI agent status",
    "longDescription": "Displays normalized Codex and Claude session status from Agent Lantern daemon.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
