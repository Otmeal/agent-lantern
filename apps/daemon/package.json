{
  "name": "@agent-lantern/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsup",
    "build:bundle": "tsup",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-lantern/protocol": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.5"
  }
}
